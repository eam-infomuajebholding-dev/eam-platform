# ============================================================
# EAM Project - Environment Variables
# ============================================================
# Copy this file to .env in the appropriate directory and fill
# in the actual values. NEVER commit real secrets to version control.
# ============================================================

# ============================================================
# FRONTEND (app/frontend/.env)
# ============================================================

# Cloudinary - Media Upload CDN
# Required for media uploads in admin edit mode
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# API Base URL (optional - defaults to http://127.0.0.1:8000)
# Set this if your backend runs on a different host/port
VITE_API_BASE_URL=http://127.0.0.1:8000

# Dev Server Port (optional - defaults to 3000)
VITE_PORT=3000

# Application Metadata (optional - used in HTML meta tags)
VITE_APP_TITLE=إعمار الأصالة والمعاصرة
VITE_APP_DESCRIPTION=شركة إعمار الأصالة والمعاصرة للاستشارات الهندسية
VITE_APP_LOGO_URL=https://your-domain.com/favicon.ico

# ============================================================
# BACKEND (app/backend environment or .env)
# ============================================================

# Database - PostgreSQL Connection
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/eam_database

# Backend Public URL (used for OIDC callbacks)
# Must be the publicly accessible URL of your backend
PYTHON_BACKEND_URL=https://your-domain.com

# Application Mode
DEBUG=false

# ---- Authentication (OIDC) ----
# OpenID Connect provider configuration.
# The backend builds these endpoints itself from OIDC_ISSUER_URL:
#   {OIDC_ISSUER_URL}/authorize
#   {OIDC_ISSUER_URL}/token
#   {OIDC_ISSUER_URL}/logout
#   {OIDC_ISSUER_URL}/.well-known/jwks.json
# So OIDC_ISSUER_URL must be the base URL WITHOUT a trailing slash.
OIDC_ISSUER_URL=https://your-oidc-provider.com/oidc
OIDC_CLIENT_ID=your_oidc_client_id
OIDC_CLIENT_SECRET=your_oidc_client_secret

# Space-separated scopes requested during login.
OIDC_SCOPE=openid profile email

# Login callback is NOT a separate variable. The backend derives it as:
#   {PYTHON_BACKEND_URL}/api/v1/auth/callback
# Register that exact URL as the redirect URI in your OIDC provider.
#
# Logout callback is derived as:
#   {FRONTEND_URL}/logout-callback
# Register that exact URL as the post-logout redirect URI.
FRONTEND_URL=http://localhost:3000

# ---- AI Chatbot (OpenAI) ----
# Required for the AI customer support chatbot
OPENAI_API_KEY=sk-your_openai_api_key_here

# ---- Payments (Stripe) ----
# Required for investment/payment features
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

# ---- Object Storage ----
# S3-compatible object storage for file uploads
# (Only needed if migrating away from Atoms Cloud storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
S3_ENDPOINT_URL=https://s3.amazonaws.com

# ---- AWS Lambda (if deploying serverless) ----
IS_LAMBDA=false
AWS_LAMBDA_FUNCTION_NAME=eam-backend

# ---- Local Development ----
# Set to "true" to patch URLs for local development
LOCAL_PATCH=false

# ============================================================
# NOTES
# ============================================================
# 
# 1. Frontend variables must be prefixed with VITE_ to be
#    accessible in the browser (Vite requirement).
#
# 2. Backend variables are read via pydantic-settings and
#    python-dotenv. They can be set in the shell environment
#    or in a .env file in the backend directory.
#
# 3. For local development with SQLite instead of PostgreSQL:
#    DATABASE_URL=sqlite+aiosqlite:///./local.db
#
# 4. OIDC provider options:
#    - Auth0: https://auth0.com
#    - Keycloak: https://www.keycloak.org
#    - AWS Cognito: https://aws.amazon.com/cognito
#
# 5. Cloudinary setup:
#    - Create account at https://cloudinary.com
#    - Create an unsigned upload preset in Settings > Upload
#    - Use the cloud name and preset name here
#
# ============================================================