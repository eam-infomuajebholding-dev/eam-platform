# Copy to app/.env — see docs/operations/GO_LIVE_CHECKLIST.md

# === CORE (required for any environment) ===
DATABASE_URL=sqlite:///./eam.db
JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# SPA origin (required for OIDC redirect after login; prod domain when live)
FRONTEND_URL=http://localhost:3000
# Local dev: proxy auth redirects to Vite (optional)
# LOCAL_PATCH=true

# === OIDC — paste when IdP is ready (login/register) ===
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid email profile
# OIDC_PROVIDER_LABEL=EAM Identity

# === Stripe — paste when payments are ready ===
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Stripe overrides
# STRIPE_SUCCESS_URL=http://localhost:3000/payment/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel?request_id={service_request_id}
# STRIPE_INVOICE_FOOTER=EAM — VAT 15% per quote. TRN: (your ZATCA TRN)

# Journey phone OTP (dev/tests — set fixed code; production needs SMS provider)
# JOURNEY_DEV_OTP=123456

# Local dev helpers (backend/scripts/)
# verify_stripe_env.py — readiness check
# stripe_listen.ps1 — forward webhooks to :8000
# stripe_go_live.ps1 — one-shot env configure + verify
# stripe_payment_smoke.py — seed quote + checkout URL
# verify_platform_readiness.py — go-live checklist (no secret values printed)
# after_env_provided.ps1 — run after you paste OIDC/Stripe

# Readiness: GET /api/v1/platform/readiness
